# Referência de configuração não sensível. Prefira deploy/install-hub.sh.
# Valores aceitos: consolidated | server | local-viewer | gitea-compact | tools
# (lista separada por vírgula). Base: consolidated ou server. Acrescente
# local-viewer ou gitea-compact somente quando esse modo de publicação for usado;
# tools contém apenas o certgen, executado sob demanda.
COMPOSE_PROFILES=consolidated,local-viewer

# Valores de referência para o CLI nativo. Injete-os no ambiente do operador; o
# Hub não depende deles. Em modo consolidado local, use https://localhost:8443.
API_HOST=https://localhost:8443
TLS_CA_FILE=/etc/lucien/ca.crt
CERTS_DIR=./certs
SECRETS_DIR=./secrets
# O instalador calcula src-<hash>. "development" serve apenas para validar config.
LUCIEN_IMAGE_TAG=development
# O instalador limita estes valores ao total informado pelo daemon Docker.
LUCIEN_TINY_CPU_LIMIT=0.50
LUCIEN_SMALL_CPU_LIMIT=1.00
LUCIEN_MEDIUM_CPU_LIMIT=1.00
LUCIEN_SLM_CPU_LIMIT=1.00
HUB_BIND_ADDRESS=127.0.0.1

# Portal local: volume somente leitura; revisões autorizadas passam pelo Hub.
VIEWER_BIND_ADDRESS=127.0.0.1
VIEWER_HUB_URL=https://hub:8443
VIEWER_SESSION_TTL_SECONDS=900
VIEWER_MAX_DOCUMENTS=10000
VIEWER_MAX_FILE_BYTES=1048576

# Segredos não pertencem ao .env. Use diretório 0700 e arquivos 0444:
# postgres_password, database_url, bootstrap_api_key, auth_pepper, git_token,
# viewer_session_secret e wiki_repository_token. Prefira install-hub.sh.
# Valores aceitos: true | false. Habilite somente durante o cadastro administrado
# e desabilite após criar o admin.
USER_CREATION_ENABLED=true
# Valores aceitos: true | false. Com false (padrão), junior não publica runbook de
# criticidade alta e nem junior nem pleno criam revisão de runbook publicado. Com
# true, ambos revisam e o junior publica alta; a revisão continua restrita ao
# próprio domain_function, como no senior. Vale para o Hub e para o portal, que
# usa o mesmo valor só para exibir o botão de edição — a autorização é sempre
# reavaliada pelo Hub.
RBAC_ENTRY_ROLES_ENABLED=false

# Funcoes de dominio aceitas em `lucien start -r`, separadas por virgula.
# Cada uma vira um diretorio no destino publicado: <ano>/<funcao>/arquivo.md.
# Governa tambem a criacao de usuarios e o enrollment de jump server: um
# usuario nao pode existir em dominio que o administrador nunca declarou.
# Nao confundir com o cargo (junior/pleno/senior/admin), que continua fixo
# no codigo porque cada um tem regra propria de RBAC.
# O wiki-builder le a mesma variavel para listar no indice as areas que ainda
# nao tem runbook; sem ela o indice mostra so as que ja tem conteudo.
# Omitir mantem o padrao historico abaixo.
RUNBOOK_DOMAIN_FUNCTIONS=acessos,servidores,redes,suporte

# Banco do Hub.
POSTGRES_DB=lucien
POSTGRES_USER=lucien

# SLM local. Em modo servidor distribuído, aponte para um serviço alcançável pelo Hub.
SLM_BASE_URL=http://slm:11434
SLM_MODEL=qwen2.5-coder:3b
# Valores aceitos: pt-br | en. Idioma do template, das tags e das sugestões.
SLM_LANGUAGE_RUNBOOK=pt-br
SLM_TIMEOUT_SECONDS=300
# Threads da SLM. 0 deixa o Ollama detectar pelo host, o que ignora a cota do
# cgroup; iguale a LUCIEN_SLM_CPU_LIMIT quando o limite for menor que o total de
# CPUs do host, senão o contêiner é throttled e cada token fica mais caro.
SLM_NUM_THREAD=0

# Janela de contexto pedida ao runtime da SLM. Zero devolve o padrao dele, que
# e 2048 tokens e corta o prompt em silencio -- levando junto a instrucao do
# sistema, o que faz o modelo responder qualquer coisa e o Job falhar com
# UPSTREAM_ERROR. Custa memoria: ver o calculo em docs/operacao.md.
SLM_NUM_CTX=8192

# Teto, em caracteres, do log reduzido enviado a SLM. O Hub ja colapsa blocos
# de saida antes de enviar; este valor e o limite final. Menor barateia cada
# tentativa num host lento, maior da mais contexto em sessoes curtas.
SLM_PROMPT_MAX_CHARS=8000

# Teto de processos gitleaks simultaneos no secret-scanner. Cada scan e um
# subprocesso; sem teto, um lote de uploads cria um por requisicao ate
# exaurir o conteiner -- e um scanner que cai bloqueia toda publicacao,
# porque a politica e fail-closed. Ver docs/operacao.md.
SCANNER_MAX_CONCURRENCY=4

# Espera maxima por uma vaga antes de recusar com 503. Recusar rapido e
# melhor que pendurar conexao: o Hub trata 503 como falha de upstream e
# reagenda o Job.
SCANNER_QUEUE_TIMEOUT_SECONDS=10
# Valores aceitos: true | false. Liga a etapa de enriquecimento, que sugere
# objetivo, impactos e rollback. Com false, o worker pula a etapa e o runbook sai
# com a estrutura básica para o operador preencher na revisão. Mesmo com true,
# uma falha do enriquecimento não derruba o Job: a extração já concluída é
# preservada. O operador também pode optar por Job com `lucien upload -s`.
SLM_ENRICHMENT_ENABLED=true
# Valores aceitos: slm | deterministic. Provedor do enriquecimento. `slm` chama o
# modelo; `deterministic` deriva tags, pré-requisitos, impactos e rollback de
# tabelas revisáveis, sem chamada externa e sem possibilidade de alucinação, e
# ignora SLM_BASE_URL, SLM_MODEL, SLM_TIMEOUT_SECONDS e SLM_NUM_THREAD.
RUNBOOK_ENRICHER=slm
UPLOAD_WORKER_POLL_SECONDS=2
UPLOAD_WORKER_LEASE_SECONDS=900
UPLOAD_WORKER_RETRY_BASE_SECONDS=10
UPLOAD_WORKER_MAX_ATTEMPTS=5
MAX_LOG_BYTES=2097152
# O Hub falha fechado se o scanner não responder ou detectar um segredo.
SECRET_SCANNER_URL=http://secret-scanner:8090
SECRET_SCANNER_TIMEOUT_SECONDS=5

# Valores aceitos: local | github | gitea. Strategy de publicação. Revisões pelo
# portal só ficam habilitadas com `local`.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/data/playbooks
GIT_API_BASE=https://api.github.com
GIT_OWNER=
GIT_REPO=
GIT_BRANCH=main
# O MkDocs publica somente arquivos dentro de docs/.
GIT_DOCS_PREFIX=docs/runbooks
# CA pública usada pelo Hub e pelo builder para validar GitHub/Gitea.
GIT_CA_SOURCE=./certs/ca.crt

# Builder fixo do modo gitea-compact. Use um token separado, somente leitura.
WIKI_REPOSITORY_URL=https://gitea.exemplo.interno/infraestrutura/runbooks.git
WIKI_REPOSITORY_BRANCH=main
WIKI_REPOSITORY_USER=lucien-builder
WIKI_POLL_SECONDS=60
WIKI_BUILD_TIMEOUT_SECONDS=120
WIKI_MAX_REPOSITORY_BYTES=536870912
WIKI_MAX_SOURCE_FILES=10000
WIKI_MAX_SOURCE_BYTES=268435456
WIKI_MAX_FILE_BYTES=1048576
WIKI_RELEASE_RETENTION=5
WIKI_BIND_ADDRESS=127.0.0.1

# SANs do certificado. Para ambiente distribuído, inclua o FQDN real da API.
CERT_DNS=hub,localhost
CERT_IP=127.0.0.1
