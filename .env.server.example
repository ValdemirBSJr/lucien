# Acrescente local-viewer ou gitea-compact somente quando necessário.
COMPOSE_PROFILES=server
API_HOST=https://runbook.exemplo.interno:8443
TLS_CA_FILE=/certs/ca.crt
CERTS_DIR=./certs
SECRETS_DIR=./secrets
LUCIEN_IMAGE_TAG=development
LUCIEN_TINY_CPU_LIMIT=0.50
LUCIEN_SMALL_CPU_LIMIT=1.00
LUCIEN_MEDIUM_CPU_LIMIT=1.00
LUCIEN_SLM_CPU_LIMIT=1.00
HUB_BIND_ADDRESS=0.0.0.0

VIEWER_BIND_ADDRESS=127.0.0.1
VIEWER_HUB_URL=https://hub:8443
VIEWER_SESSION_TTL_SECONDS=900
VIEWER_MAX_DOCUMENTS=10000
VIEWER_MAX_FILE_BYTES=1048576

# Credenciais ficam em arquivos sob SECRETS_DIR; prefira install-hub.sh.
USER_CREATION_ENABLED=false

POSTGRES_DB=lucien
POSTGRES_USER=lucien

# O worker pode alcançar uma SLM em outra máquina, nunca exposta à Internet pública.
SLM_BASE_URL=http://slm.exemplo.interno:11434
SLM_MODEL=qwen2.5-coder:3b
SLM_TIMEOUT_SECONDS=300
UPLOAD_WORKER_POLL_SECONDS=2
UPLOAD_WORKER_LEASE_SECONDS=900
UPLOAD_WORKER_RETRY_BASE_SECONDS=10
UPLOAD_WORKER_MAX_ATTEMPTS=5
MAX_LOG_BYTES=2097152

STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/data/playbooks
GIT_API_BASE=https://api.github.com
GIT_OWNER=
GIT_REPO=
GIT_BRANCH=main
GIT_DOCS_PREFIX=docs/runbooks
GIT_CA_SOURCE=./certs/ca.crt

# Usado apenas com COMPOSE_PROFILES=server,gitea-compact.
WIKI_REPOSITORY_URL=https://gitea.exemplo.interno/infraestrutura/runbooks.git
WIKI_REPOSITORY_BRANCH=main
WIKI_REPOSITORY_USER=lucien-builder
WIKI_POLL_SECONDS=60
WIKI_BUILD_TIMEOUT_SECONDS=120
WIKI_MAX_REPOSITORY_BYTES=536870912
WIKI_MAX_SOURCE_FILES=10000
WIKI_MAX_SOURCE_BYTES=268435456
WIKI_MAX_FILE_BYTES=1048576
WIKI_RELEASE_RETENTION=5
WIKI_BIND_ADDRESS=127.0.0.1

CERT_DNS=runbook.exemplo.interno,hub,localhost
CERT_IP=127.0.0.1
